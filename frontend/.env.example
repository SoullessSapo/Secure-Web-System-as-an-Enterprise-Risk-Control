# Copy to .env.local (development) or .env.production.local (deployment build). Never commit those files.
# The SPA only needs public values: never put an Auth0 client secret here.
VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://enterprise-risk-api
# Development: http://localhost:8080   Production: https://YOUR-SUBDOMAIN.duckdns.org
VITE_API_URL=http://localhost:8080
